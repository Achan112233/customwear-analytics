{
  "family": "customwear-analytics-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/customwearAnalyticsTaskRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com/customwear-analytics:latest",
      "essential": true,
      "portMappings": [{"containerPort": 8000, "protocol": "tcp"}],
      "environment": [{"name": "APP_ENV", "value": "production"}],
      "secrets": [
        {"name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/customwear/database-url"},
        {"name": "REDIS_URL", "valueFrom": "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/customwear/redis-url"},
        {"name": "API_KEY", "valueFrom": "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/customwear/api-key"}
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health/live')\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/customwear-analytics",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
